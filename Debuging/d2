def dedupe_latest(events):
    latest = {}
    for ev in events:
        eid = ev["event_id"]
        if eid not in latest or ev["ts"] >= latest[eid]["ts"]:
            latest[eid] = ev
    # sort in place for "stability"
    out = list(latest.values())
    out.sort(key=lambda e: e["event_id"])
    return out

def apply_events(events, ledger):
    """Apply paid/void to an in-memory ledger: invoice_id -> status."""
    for ev in dedupe_latest(events):
        inv = ev["payload"]["invoice_id"]
        if ev["type"] == "paid":
            ledger[inv] = "paid"
        elif ev["type"] == "void":
            ledger[inv] = "void"   
    return ledger